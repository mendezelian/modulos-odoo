<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id = "view_player_form" model="ir.ui.view">
        <field name="name">res_partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
	<field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <header>
                    <button name="action_sync_puntos" string="Actualizar Puntos" type="object" class="oe_highlight" invisible="not is_player"/>
                </header>
                <page string="Jugador" name="player_stats">
                    <group>
			<group string="Identidad">
	                    <field name="is_player"/>
                            <field name="nickname" invisible="not is_player"/>
                            <field name="avatar" widget="image" class="oe_avatar" invisible="not is_player"/>
                        </group>
                        <group string="Progreso" invisible="not is_player">
                            <field name="nivel" readonly="1" class="font-weight-bold"/>
                            <field name="level_progress" widget="progressbar"/>
                            
                            <label for="rank_id" string="Rango"/>
                            <div class="o_row">
                                <field name="rank_image" widget="image" class="oe_avatar" options="{'size': [40, 40]}"/>
                                <field name="rank_id" readonly="1"/>
                            </div>

                            <field name="puntos_acumulados" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-gamepad" invisible="not is_player">
                    <field name="session_count" widget="statinfo" string="Partidas"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- KANBAN INHERITANCE -->
    <record id="view_player_kanban" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="is_player"/>
                <field name="nivel"/>
                <field name="rank_image"/>
                <field name="avatar"/>
                <field name="puntos_acumulados"/>
            </xpath>

            <xpath expr="//templates" position="inside">
                <t t-name="kanban-box" t-if="record.is_player.raw_value">
                    <div class="oe_kanban_global_click" style="border-radius: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 0; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin: 8px;">
                        <!-- Header with gradient -->
                        <div style="background: rgba(255,255,255,0.95); padding: 20px; border-radius: 12px 12px 0 0;">
                            <!-- Avatar Section -->
                            <div style="text-align: center; margin-bottom: 15px;">
                                <div style="width: 80px; height: 80px; margin: 0 auto; border-radius: 50%; overflow: hidden; border: 4px solid #667eea; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
                                    <img t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)" 
                                         alt="Avatar" 
                                         style="width: 100%; height: 100%; object-fit: cover;"/>
                                </div>
                            </div>
                            
                            <!-- Name -->
                            <div style="text-align: center; margin-bottom: 10px;">
                                <h4 style="margin: 0; font-size: 18px; font-weight: 600; color: #2d3748;">
                                    <field name="display_name"/>
                                </h4>
                                <p style="margin: 5px 0 0 0; font-size: 13px; color: #718096;">
                                    <field name="email"/>
                                </p>
                            </div>
                            
                            <!-- Stats Row -->
                            <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 15px; padding: 12px; background: #f7fafc; border-radius: 8px;">
                                <div style="text-align: center;">
                                    <div style="font-size: 11px; color: #718096; text-transform: uppercase; letter-spacing: 0.5px;">Nivel</div>
                                    <div style="font-size: 20px; font-weight: 700; color: #667eea; margin-top: 2px;">
                                        <field name="nivel"/>
                                    </div>
                                </div>
                                <div style="width: 1px; height: 30px; background: #e2e8f0;"></div>
                                <div style="text-align: center;">
                                    <div style="font-size: 11px; color: #718096; text-transform: uppercase; letter-spacing: 0.5px;">Puntos</div>
                                    <div style="font-size: 20px; font-weight: 700; color: #48bb78; margin-top: 2px;">
                                        <field name="puntos_acumulados"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Footer with Rank -->
                        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 12px 20px; display: flex; align-items: center; justify-content: center; gap: 10px;">
                            <field name="rank_image" widget="image" options="{'size': [28, 28]}" style="border-radius: 4px;"/>
                            <span style="color: white; font-weight: 600; font-size: 14px; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                <field name="rank_id"/>
                            </span>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
