<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KANBAN VIEW -->
    <record id="view_game_session_kanban" model="ir.ui.view">
        <field name="name">game.session.kanban</field>
        <field name="model">game.session</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="player_id"/>
                <field name="game_id"/>
                <field name="score"/>
                <field name="state"/>
                <field name="date_start"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="player_id" widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="player_id"/>
                                </strong>
                                <ul>
                                    <li>Juego: <field name="game_id"/></li>
                                    <li>Score: <field name="score"/></li>
                                    <li>Fecha: <field name="date_start"/></li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" options="{'classes': {'in_progress': 'default', 'finished': 'success', 'abandoned': 'danger'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <!-- Icono del juego (limitado en tamaño) -->
                                        <field name="game_id" widget="image" options="{'max_width': 24, 'max_height': 24}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_game_session_form" model="ir.ui.view">
        <field name="name">game.session.form</field>
        <field name="model">game.session</field>
        <field name="arch" type="xml">
            <form string="Sesión de Juego">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="player_id"/>
                            <field name="game_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="duration"/>
                            <field name="score"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_game_session_tree" model="ir.ui.view">
        <field name="name">game.session.tree</field>
        <field name="model">game.session</field>
        <field name="arch" type="xml">
            <list string="Sesiones de Juego">
                <field name="name"/>
                <field name="player_id"/>
                <field name="game_id"/>
                <field name="date_start"/>
                <field name="score"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_game_session" model="ir.actions.act_window">
        <field name="name">Sesiones de Juego</field>
        <field name="res_model">game.session</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear la primera sesión de juego
            </p>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_gamehub_root" name="GameHub" sequence="10"/>
    <menuitem id="menu_game_sessions" name="Sesiones de Juego" parent="menu_gamehub_root" action="action_game_session" sequence="10"/>

    <menuitem id="menu_game_configuration" name="Configuración" parent="menu_gamehub_root" sequence="100"/>
    <menuitem id="menu_game_ranks" name="Rangos y Logros" parent="menu_game_configuration" action="game_players.action_game_rank"/>

</odoo>
