<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id = "view_player_form" model="ir.ui.view">
        <field name="name">res_partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
	<field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
		<page string="Jugador" name="player_stats">
                    <group>
			<group string="Identidad">
	                    <field name="is_player"/>
                            <field name="nickname" invisible="not is_player"/>
                            <field name="avatar" widget="image" class="oe_avatar" invisible="not is_player"/>
                        </group>
                        <group string="Progreso" invisible="not is_player">
                            <div class="o_row">
                                <label string="Nivel: " for="nivel"/>
                                <field name="nivel" readonly="1"/> 
                                <label string="Barra de Progreso: " for="nivel"/>
                                <field name="nivel" widget="progressbar"
                                    options="{'current_value':'nivel', 'max_value':100, 'editable':false, 'display_stat':false}"
                                    readonly="1" nolabel="1"/>
                            </div>
                            <field name="logros" readonly="1"/>
                            <field name="puntos_acumulados" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
