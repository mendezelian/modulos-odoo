<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_game_rank_tree" model="ir.ui.view">
        <field name="name">game.rank.tree</field>
        <field name="model">game.rank</field>
        <field name="arch" type="xml">
            <list string="Rangos de Juego">
                <field name="min_points"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_game_rank_form" model="ir.ui.view">
        <field name="name">game.rank.form</field>
        <field name="model">game.rank</field>
        <field name="arch" type="xml">
            <form string="Rango de Juego">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="min_points"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_game_rank" model="ir.actions.act_window">
        <field name="name">Rangos y Logros</field>
        <field name="res_model">game.rank</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
