<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id = "view_partner_from_game_inherit" model="ir.ui.view">
        <field name="name">res.partner.from.game.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Estado de jugadores" name="player_stats">
                    <group>
                        <group string="Identidad">
                            <field name="is_player"/>
                            <field name="nickname" invisible="not is_player"/>
                            <field name="avatar" widget="image" class="oe_avatar" invisible="not is_player"/>
                        </group>
                        <group string="Progreso">
                            <field name="nivel" readonly="1" invisible="not is_player"/>
                            <field widget="progressbar"
                                options="{'current_value':'nivel', 'max_value':100, 'editable':false}"
                                readonly="1" invisible="not is_player"/>
                            <field name="logros" readonly="1" invisible="not is_player"/>
                            <field name="puntos_acumulados"  invisible="not is_player"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
